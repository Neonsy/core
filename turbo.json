{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "lint:fix": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    },
    "//#generate:docs": {
      "dependsOn": ["@fluxerjs/docgen#build"],
      "outputs": ["apps/docs/public/api/**"],
      "inputs": [
        "scripts/generate-docs.ts",
        "packages/docgen/src/**",
        "packages/*/src/**",
        "packages/*/tsconfig.json",
        "packages/fluxer-core/src/**",
        "packages/fluxer-core/tsconfig.json"
      ]
    },
    "openapi:verify": {
      "dependsOn": [],
      "inputs": ["vendor/openapi/**", "scripts/openapi/**"]
    }
  }
}
